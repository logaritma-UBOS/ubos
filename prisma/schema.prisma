generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  }

// 1. Core, Auth & Settings
model User {
  id            String     @id @default(uuid()) // standard NextAuth wants cuid, but uuid is fine too
  name          String?    // made optional for NextAuth standard
  email         String     @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?    // made optional since OAuth users won't have one
  role          String     @default("OWNER")
  createdAt     DateTime   @default(now())
  
  accounts      Account[]
  sessions      Session[]
  businesses    Business[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String
  businessType   String
  operatingDays  Int       @default(7)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  
  settings       BusinessSetting?
  auditLogs      AuditLog[]
  categories     ProductCategory[]
  products       Product[]
  ingredients    Ingredient[]
  recipes        Recipe[]
  stockMovements StockMovement[]
  sales          Sale[]
  saleItems      SaleItem[]
  expenses       Expense[]
  incomes        Income[]
  customers      Customer[]
  goals          Goal[]
  metrics        BusinessMetricSnapshot[]
  recommendations Recommendation[]
  syncQueues     SyncQueue[]
  pilotEvents    PilotEvent[]
  pilotErrors    PilotError[]
  pilotFeedbacks PilotFeedback[]
  promos         Promo[]
  contentPlans   ContentPlan[]
  campaigns      Campaign[]
}

model BusinessSetting {
  id           String   @id @default(uuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  baseCurrency String   @default("IDR")
  timezone     String   @default("Asia/Jakarta")
  taxRate      Float    @default(0)
  receiptFooter String?
  storeAddress  String?
  storePhone    String?
  fonnteToken   String?
  waStatus      String   @default("DISCONNECTED")
}

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  action      String
  resource    String
  detailsJson String?
  createdAt   DateTime @default(now())
}

// 2. Catalog, Recipe & Stock (Barang & Produk)
model ProductCategory {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]
}

model Product {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  name            String
  imageUrl        String?
  imagePublicId   String?
  sellPrice       Float
  calculatedHpp   Float            @default(0)
  calculatedMargin Float           @default(0)
  isActive        Boolean          @default(true)
  
  // Phase 1: Unified Item Behavior Flags
  isSellable      Boolean          @default(true)
  isPurchasable   Boolean          @default(false)
  trackInventory  Boolean          @default(false)
  hasBOM          Boolean          @default(false)
  purchaseCost    Float            @default(0) // Phase 3

  recipes         Recipe[]
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
}

model Ingredient {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  unit           String
  costPerUnit    Float
  currentStock   Float           @default(0)
  minStock       Float           @default(0)
  
  // Phase 1: Unified Item Behavior Flags
  isSellable      Boolean          @default(false)
  isPurchasable   Boolean          @default(true)
  trackInventory  Boolean          @default(true)
  hasBOM          Boolean          @default(false)

  recipes        Recipe[]
  stockMovements StockMovement[]
}

model Recipe {
  id             String     @id @default(uuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityNeeded Float
}

// 2. Inventory (Gudang)
model StockMovement {
  id           String      @id @default(uuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         String      // IN, OUT, WASTE, SALE
  quantity     Float
  referenceId  String?
  referenceType String?    // SALE, PURCHASE, ADJUSTMENT
  date         DateTime    @default(now())
}

// 3. Sales & Transactions (Jualan)
model Sale {
  id                  String     @id @default(uuid())
  businessId          String
  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientTransactionId String     @unique
  receiptNumber       String?
  totalAmount         Float
  discount            Float      @default(0)
  paymentMethod       String     // CASH, QR, TRANSFER
  cashReceived        Float?
  changeAmount        Float?
  customerId          String?
  customer            Customer?  @relation(fields: [customerId], references: [id])
  promoId             String?
  promo               Promo?     @relation(fields: [promoId], references: [id])
  campaignId          String?
  campaign            Campaign?  @relation(fields: [campaignId], references: [id])
  syncStatus          String     @default("SYNCED") // LOCAL, PENDING, SYNCED, FAILED
  createdAt           DateTime   @default(now())
  syncedAt            DateTime?
  saleItems           SaleItem[]
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  priceAtSale Float
  hppAtSale   Float
}

// 4. Finance (Keuangan Dasar)
model Expense {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  description String?
  date        DateTime @default(now())
}

model Income {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source      String
  amount      Float
  description String?
  date        DateTime @default(now())
}

// 5. Customer & Metrics (Loyalty & Target)
model Customer {
  id               String    @id @default(uuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  totalPurchases   Int       @default(0)
  lastPurchaseDate DateTime?
  category         String?  // BARU, AKTIF, LAMA
  sales            Sale[]
}

model Goal {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targetOmzet       Float
  targetProfit      Float?
  targetTransaction Int?
  period            String   // BULANAN, HARIAN
}

model BusinessMetricSnapshot {
  id                     String   @id @default(uuid())
  businessId             String
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date                   DateTime @default(now())
  omzetAktual            Float    @default(0)
  aovAktual              Float    @default(0)
  transactionCountAktual Int      @default(0)
  hppTotal               Float    @default(0)
}

// Recommendation & Sync
model Recommendation {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  metricType     String   // OMZET, AOV, FREQUENCY
  currentValue   Float
  targetValue    Float
  gap            Float
  dataConfidence String   // LOW, MEDIUM, HIGH
  causeText      String
  actionText     String
  priorityScore  Int      // 1-100
  status         String   @default("TODO") // TODO, IN_PROGRESS, DISMISSED, COMPLETED
}

model SyncQueue {
  id                  String   @id @default(uuid())
  businessId          String
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientTransactionId String   @unique
  payloadJson         String
  status              String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  retryCount          Int      @default(0)
  lastAttempt         DateTime?
}

model PilotEvent {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eventName   String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventName])
}

model PilotError {
  id          String   @id @default(uuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  errorType   String
  message     String
  stackTrace  String?
  path        String?
  createdAt   DateTime @default(now())
}

model PilotFeedback {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String   // BUG, FEATURE, GENERAL
  content     String
  createdAt   DateTime @default(now())
}

// 6. Promo Engine
model Promo {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  code            String
  discountType    String    // PERCENTAGE, FIXED
  discountValue   Float
  minimumPurchase Float?
  startAt         DateTime?
  endAt           DateTime?
  maxUsage        Int?
  usageCount      Int       @default(0)
  targetSegment   String?   // BARU, AKTIF, LOYAL, dll
  isActive        Boolean   @default(true)
  sales           Sale[]
  campaigns       Campaign[]

  @@unique([businessId, code])
}

// 7. Content Planner
model ContentPlan {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  platform        String    // TIKTOK, INSTAGRAM, FACEBOOK, WHATSAPP_STATUS
  status          String    // DRAFT, SIAP_POSTING, SUDAH_POSTING
  cta             String?
  targetUrl       String?
  postDate        DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  campaigns       Campaign[]
}

// 8. Marketing Campaigns (WhatsApp Blast layer)
model Campaign {
  id            String       @id @default(uuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  contentPlanId String?
  contentPlan   ContentPlan? @relation(fields: [contentPlanId], references: [id])
  targetSegment String       // BARU, AKTIF, LOYAL, BERISIKO, TIDAK_AKTIF, SEMUA
  message       String?
  cta           String?
  promoId       String?
  promo         Promo?       @relation(fields: [promoId], references: [id])
  linkUrl       String?
  status        String       @default("DRAFT") // DRAFT, SIAP_DIKIRIM, TERKIRIM, SELESAI
  sentAt        DateTime?
  
  sales         Sale[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
